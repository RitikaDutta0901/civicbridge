generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChallengeStatus {
  open
  in_progress
  resolved
}
enum UserRole {
  CITIZEN
  STUDENT
  RESEARCHER
  INDUSTRY_PARTNER
  GOVERNMENT_REPRESENTATIVE
  ADMINISTRATOR
}
enum SolutionStatus {
  proposed
  under_review
  accepted
  rejected
}
enum ProgressUpdateType {
  STATUS
  UPDATE
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(CITIZEN)
  createdAt    DateTime    @default(now())
  challenges   Challenge[] @relation("AuthorChallenges")
  votes        Vote[]
  organizations Organization[]
  solutions    Solution[] @relation("AuthorSolutions")
  comments     Comment[]
  collaborations Collaboration[]
  progressUpdates ProgressUpdate[]
  notifications Notification[]
  recommendations Recommendation[]
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String
  expectedImpact String
  supportingInformation String?
  proposedSolutions String?
  category    String
  location    String
  status      ChallengeStatus @default(open)
  votes       Int      @default(0)
  authorId    String?
  author      User?    @relation("AuthorChallenges", fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  voteRecords Vote[]
  solutions   Solution[]
  organizations Organization[]
  comments     Comment[]
  collaborations Collaboration[]
  timeline ProgressUpdate[] @relation("ChallengeProgress")
  notifications Notification[] @relation("ChallengeNotifications")
  recommendations Recommendation[]
  @@index([authorId, createdAt])
  @@index([category, createdAt])
  @@index([status, createdAt])
  @@index([location, createdAt])
  @@index([title])
}

model Solution {
  id          String    @id @default(cuid())
  title       String
  description String
  proposedApproach String?
  expectedImpact String?
  requiredResources String?
  authorId String?
  author User? @relation("AuthorSolutions", fields: [authorId], references: [id])
  status SolutionStatus @default(proposed)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  comments Comment[]
  collaborations Collaboration[]
  @@index([challengeId])
  @@index([authorId])
}

model Organization {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  users       User[]
  challenges  Challenge[]
}

model Vote {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  user        User      @relation(fields: [userId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  createdAt   DateTime  @default(now())
  @@unique([userId, challengeId])
}

model Collaboration {
  id String @id @default(cuid())
  userId String
  challengeId String?
  solutionId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solution Solution? @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, challengeId, solutionId])
  @@index([challengeId])
}

model Comment {
  id String @id @default(cuid())
  body String
  userId String
  challengeId String?
  solutionId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solution Solution? @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([challengeId])
  @@index([solutionId])
}

model ProgressUpdate {
  id String @id @default(cuid())
  challengeId String
  challenge Challenge @relation("ChallengeProgress", fields: [challengeId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type ProgressUpdateType @default(UPDATE)
  status ChallengeStatus?
  body String
  createdAt DateTime @default(now())
  @@index([challengeId, createdAt])
  @@index([authorId, createdAt])
}

model Notification {
  id String @id @default(cuid())
  recipientId String
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  challengeId String?
  challenge Challenge? @relation("ChallengeNotifications", fields: [challengeId], references: [id], onDelete: Cascade)
  type String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([recipientId, readAt, createdAt])
  @@index([challengeId, createdAt])
}

model Recommendation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  score Int @default(0)
  createdAt DateTime @default(now())
  @@unique([userId, challengeId])
  @@index([userId, score])
}
