generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChallengeStatus {
  open
  in_progress
  resolved
}
enum UserRole {
  CITIZEN
  STUDENT
  RESEARCHER
  INDUSTRY_PARTNER
  GOVERNMENT_REPRESENTATIVE
  ADMINISTRATOR
}
enum SolutionStatus {
  proposed
  under_review
  accepted
  rejected
}
enum ProgressUpdateType {
  STATUS
  UPDATE
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(CITIZEN)
  createdAt    DateTime    @default(now())
  challenges   Challenge[] @relation("AuthorChallenges")
  votes        Vote[]
  organizationMemberships OrganizationMembership[]
  membershipRequests OrganizationMembershipRequest[] @relation("MembershipRequester")
  ownedProjects Project[] @relation("ProjectOwner")
  projectMemberships ProjectTeamMembership[]
  projectTeamRequests ProjectTeamRequest[] @relation("ProjectTeamRequester")
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks Task[] @relation("TaskCreator")
  evaluations SolutionEvaluation[]
  submittedDeliverables Deliverable[] @relation("DeliverableSubmitter")
  reviewedDeliverables Deliverable[] @relation("DeliverableReviewer")
  activities ActivityRecord[]
  solutions    Solution[] @relation("AuthorSolutions")
  comments     Comment[]
  collaborations Collaboration[]
  progressUpdates ProgressUpdate[]
  notifications Notification[]
  recommendations Recommendation[]
  submittedReports ModerationReport[] @relation("ReportReporter")
  reviewedReports ModerationReport[] @relation("ReportReviewer")
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String
  expectedImpact String
  supportingInformation String?
  proposedSolutions String?
  category    String
  location    String
  status      ChallengeStatus @default(open)
  votes       Int      @default(0)
  authorId    String?
  author      User?    @relation("AuthorChallenges", fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  voteRecords Vote[]
  solutions   Solution[]
  organizations Organization[]
  comments     Comment[]
  collaborations Collaboration[]
  timeline ProgressUpdate[] @relation("ChallengeProgress")
  notifications Notification[] @relation("ChallengeNotifications")
  recommendations Recommendation[]
  projects Project[]
  @@index([authorId, createdAt])
  @@index([category, createdAt])
  @@index([status, createdAt])
  @@index([location, createdAt])
  @@index([title])
  reports ModerationReport[]
}

model Solution {
  id          String    @id @default(cuid())
  title       String
  description String
  proposedApproach String?
  expectedImpact String?
  requiredResources String?
  authorId String?
  author User? @relation("AuthorSolutions", fields: [authorId], references: [id])
  status SolutionStatus @default(proposed)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  comments Comment[]
  collaborations Collaboration[]
  evaluations SolutionEvaluation[]
  projects Project[]
  reports ModerationReport[]
  @@index([challengeId])
  @@index([authorId])
}

model Organization {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  organizationType String?
  expertise   String?
  createdAt   DateTime     @default(now())
  memberships OrganizationMembership[]
  membershipRequests OrganizationMembershipRequest[]
  challenges  Challenge[]
  projects    Project[]
  @@index([createdAt])
}

enum MembershipRequestStatus {
  pending
  approved
  rejected
  withdrawn
}
enum ProjectStatus {
  proposed
  active
  paused
  completed
  archived
}
enum TeamRequestStatus {
  pending
  approved
  rejected
  withdrawn
}
enum MilestoneStatus {
  planned
  in_progress
  completed
  blocked
}
enum TaskStatus {
  todo
  in_progress
  blocked
  done
}
enum DeliverableStatus {
  draft
  submitted
  approved
  changes_requested
  rejected
}
enum ModerationStatus {
  pending
  reviewed
  dismissed
  actioned
}

model ModerationReport {
  id String @id @default(cuid())
  reporterId String
  challengeId String?
  solutionId String?
  reason String
  details String?
  status ModerationStatus @default(pending)
  moderatorId String?
  resolution String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator User? @relation("ReportReviewer", fields: [moderatorId], references: [id], onDelete: SetNull)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solution Solution? @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([challengeId])
  @@index([solutionId])
  @@unique([reporterId, challengeId, solutionId])
}

model OrganizationMembership {
  id String @id @default(cuid())
  organizationId String
  userId String
  role String @default("member")
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationMembershipRequest {
  id String @id @default(cuid())
  organizationId String
  requesterId String
  message String?
  status MembershipRequestStatus @default(pending)
  reviewedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester User @relation("MembershipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  @@unique([organizationId, requesterId, status])
  @@index([organizationId, status, createdAt])
}

model Project {
  id String @id @default(cuid())
  organizationId String
  ownerId String
  name String
  description String
  status ProjectStatus @default(proposed)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner User @relation("ProjectOwner", fields: [ownerId], references: [id])
  team ProjectTeamMembership[]
  teamRequests ProjectTeamRequest[]
  milestones Milestone[]
  tasks Task[]
  evaluations SolutionEvaluation[]
  deliverables Deliverable[]
  activities ActivityRecord[]
  challengeId String?
  solutionId String?
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  solution Solution? @relation(fields: [solutionId], references: [id], onDelete: SetNull)
  @@index([organizationId, status, createdAt])
  @@index([ownerId])
  @@index([challengeId])
  @@index([solutionId])
}

model ProjectTeamMembership {
  id String @id @default(cuid())
  projectId String
  userId String
  role String @default("member")
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectTeamRequest {
  id String @id @default(cuid())
  projectId String
  requesterId String
  message String?
  status TeamRequestStatus @default(pending)
  reviewedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester User @relation("ProjectTeamRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  @@unique([projectId, requesterId, status])
  @@index([projectId, status, createdAt])
}

model Milestone {
  id String @id @default(cuid())
  projectId String
  name String
  description String?
  dueDate DateTime?
  status MilestoneStatus @default(planned)
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks Task[]
  @@index([projectId, status, dueDate])
}

model Task {
  id String @id @default(cuid())
  projectId String
  milestoneId String?
  assigneeId String?
  creatorId String
  title String
  description String?
  status TaskStatus @default(todo)
  dueDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator User @relation("TaskCreator", fields: [creatorId], references: [id])
  @@index([projectId, status])
  @@index([assigneeId, status])
}

model SolutionEvaluation {
  id String @id @default(cuid())
  projectId String
  solutionId String
  evaluatorId String
  impact Int
  feasibility Int
  sustainability Int
  equity Int
  innovation Int
  comments String?
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  evaluator User @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  @@unique([projectId, solutionId, evaluatorId])
  @@index([projectId, createdAt])
}

model Deliverable {
  id String @id @default(cuid())
  projectId String
  submittedById String
  reviewerId String?
  title String
  description String?
  externalUrl String
  urlHost String
  status DeliverableStatus @default(draft)
  reviewerFeedback String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User @relation("DeliverableSubmitter", fields: [submittedById], references: [id])
  reviewer User? @relation("DeliverableReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  @@index([projectId, status, createdAt])
}

model ActivityRecord {
  id String @id @default(cuid())
  projectId String
  actorId String?
  type String
  message String
  metadata Json?
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([projectId, createdAt])
}

model Vote {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  user        User      @relation(fields: [userId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  createdAt   DateTime  @default(now())
  @@unique([userId, challengeId])
}

model Collaboration {
  id String @id @default(cuid())
  userId String
  challengeId String?
  solutionId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solution Solution? @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, challengeId, solutionId])
  @@index([challengeId])
}

model Comment {
  id String @id @default(cuid())
  body String
  userId String
  challengeId String?
  solutionId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solution Solution? @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([challengeId])
  @@index([solutionId])
}

model ProgressUpdate {
  id String @id @default(cuid())
  challengeId String
  challenge Challenge @relation("ChallengeProgress", fields: [challengeId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type ProgressUpdateType @default(UPDATE)
  status ChallengeStatus?
  body String
  createdAt DateTime @default(now())
  @@index([challengeId, createdAt])
  @@index([authorId, createdAt])
}

model Notification {
  id String @id @default(cuid())
  recipientId String
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  challengeId String?
  challenge Challenge? @relation("ChallengeNotifications", fields: [challengeId], references: [id], onDelete: Cascade)
  type String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([recipientId, readAt, createdAt])
  @@index([challengeId, createdAt])
}

model Recommendation {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  score Int @default(0)
  createdAt DateTime @default(now())
  @@unique([userId, challengeId])
  @@index([userId, score])
}
